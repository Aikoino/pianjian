{
  "name": "pianjian",
  "version": "1.7.0",
  "description": "片笺 - 轻量级桌面便签软件",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "build": "node scripts/build.js"
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.pianjian.app",
    "productName": "片笺",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "start.js",
      "renderer/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "electronDist": "node_modules/electron/dist"
  }
}
